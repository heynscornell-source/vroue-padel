rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Niks is sonder aanmelding leesbaar nie — nie name, nie bankbesonderhede,
    // nie tellings nie. Slegs die gedeelde groeprekening kan aanmeld.
    match /seasons/{seasonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.size() < 60
                   && request.resource.data.players.size() == 8;
    }

    // Alles anders is toe.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
